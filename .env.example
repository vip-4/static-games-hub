# OpenArc build/fetch secrets — COPY this file to `.env` and fill in.
# `.env` is gitignored; `.env.example` is committed as a template only.
# NONE of these are required to build the site; they only enrich the catalog.

# itch.io API key (optional) — https://itch.io/user/settings/api-keys
ITCH_IO_API_KEY=

# GitHub token (optional, raises rate limits) — https://github.com/settings/tokens
GITHUB_TOKEN=

# Pexels API key (optional) — fetches cover images for game cards/detail pages.
# Get one at https://www.pexels.com/api/new  (used by: python scripts/fetch-games.py --covers)
PEXELS_API_KEY=

# Pixabay API key (optional) — fallback cover image source.
# Get one at https://pixabay.com/api/docs/  (used by: python scripts/fetch-games.py --covers)
PIXABAY_API_KEY=
