# Copy to .env and fill in — NEVER commit the filled file.
# These are variable NAMES only. Do not paste real secrets into this repo.
# Add .env to .gitignore.

# --- Cloudflare R2 (S3-compatible static hosting) ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_ENDPOINT=            # optional; derived from R2_ACCOUNT_ID

# --- Cloudflare Pages (via wrangler) ---
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# --- Optional: itch.io catalog refresh (never required) ---
ITCH_IO_API_KEY=
